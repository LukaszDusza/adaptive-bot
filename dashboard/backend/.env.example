# Dashboard API Configuration

# API Settings
API_TITLE="Adaptive Bot Dashboard API"
API_VERSION="1.0.0"
API_PREFIX="/api"

# Server
HOST="0.0.0.0"
PORT=8000
RELOAD=True

# Logging
LOG_LEVEL="INFO"

# Bybit API (for emergency close - optional)
# BYBIT_API_KEY=your_api_key_here
# BYBIT_API_SECRET=your_api_secret_here
# BYBIT_BASE_URL=https://api.bybit.com  # or demo URL

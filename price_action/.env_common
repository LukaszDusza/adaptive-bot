# Common environment variables for all bots
# This file is loaded by all containers in docker-compose.yaml

# Logging configuration
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
                # DEBUG = verbose with all feature calculation steps
                # INFO = compact logs with key metrics only (default)
                # WARNING = minimal logs, only warnings and errors

# Docker environment flag (disables tqdm progress bars)
DOCKER_CONTAINER=true
